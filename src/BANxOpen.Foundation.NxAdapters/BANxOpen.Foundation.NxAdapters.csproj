<Project Sdk="Microsoft.NET.Sdk">

  <!--
    In BANxOpen.Foundation.sln so it loads in the IDE, but with an ActiveCfg entry and NO Build.0 entry in
    any configuration: it references real NXOpen/UFSession assemblies that only resolve on a machine with
    NX installed (UGII_BASE_DIR set). That arrangement is what keeps `dotnet build`/`dotnet test` on the
    .sln working everywhere else. Build it explicitly on an NX machine:
    `dotnet build src\BANxOpen.Foundation.NxAdapters\BANxOpen.Foundation.NxAdapters.csproj`.

    Materials\ holds the NX side of the material engine: the IPartMaterialService implementation and the
    physical/display material helpers it drives. It lives here rather than in a separate assembly so that
    the number of DLLs deployed into NX does not grow, since every consumer already references this
    project for NxSessionContext and UndoScope.
  -->

  <!--
    This project builds first when a consumer references it, so the guard has to live here too — without
    it, a build without NX fails as dozens of CS0246 "type or namespace 'NXOpen' not found" errors from
    this project's own sources, burying the actual cause.
  -->
  <Target Name="RequireUgiiBaseDir" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(UGII_BASE_DIR)' == ''"
           Text="UGII_BASE_DIR is not set. This project references the NXOpen managed assemblies and can only be built on a machine with NX installed." />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\BANxOpen.Foundation.Contracts\BANxOpen.Foundation.Contracts.csproj" />
    <ProjectReference Include="..\BANxOpen.Foundation.Core\BANxOpen.Foundation.Core.csproj" />
    <!-- Materials\PartMaterialService implements IPartMaterialService and executes the plan and
         side-effect instruction types, all of which live in Core.Materials. -->
    <ProjectReference Include="..\BANxOpen.Foundation.Core.Materials\BANxOpen.Foundation.Core.Materials.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
  </PropertyGroup>

  <!--
    Per Skills/common.md non-negotiable #4: no hardcoded install paths, reference via UGII_BASE_DIR.
    Verified against NX 2412: the managed assemblies live in NXBIN\managed (net48), NOT directly under
    $(UGII_BASE_DIR)\managed as previously assumed. NXBIN\managed_core is the .NET-Core-targeted copy —
    this project is net48, so it wants the former.
  -->
  <PropertyGroup>
    <NxManagedDir>$(UGII_BASE_DIR)\NXBIN\managed</NxManagedDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="NXOpen">
      <HintPath>$(NxManagedDir)\NXOpen.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="NXOpen.UF">
      <HintPath>$(NxManagedDir)\NXOpen.UF.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- NXOpen.TaggedObject and the NXRemotableObject base live here, not in NXOpen.dll. -->
    <Reference Include="NXOpen.Utilities">
      <HintPath>$(NxManagedDir)\NXOpen.Utilities.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!--
      NXOpen.UI and NXOpen.NXMessageBox ship in NXOpenUI.dll, not NXOpen.dll — verified against NX 2412.
      NxSessionContext and NxMessageBoxHelper both depend on them.
    -->
    <Reference Include="NXOpenUI">
      <HintPath>$(NxManagedDir)\NXOpenUI.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

</Project>
