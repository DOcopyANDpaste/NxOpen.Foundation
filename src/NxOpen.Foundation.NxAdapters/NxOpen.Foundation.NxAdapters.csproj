<Project Sdk="Microsoft.NET.Sdk">

  <!--
    NOT added to NxOpen.Foundation.sln — references real NXOpen/UFSession assemblies that only resolve
    on a machine with NX installed (UGII_BASE_DIR set), exactly mirroring this repo's own
    NxAdapters.csproj convention. Add it to the solution once building on such a machine; until then
    `dotnet build`/`dotnet test` on the .sln intentionally do not touch this project.
  -->

  <ItemGroup>
    <ProjectReference Include="..\NxOpen.Foundation.Contracts\NxOpen.Foundation.Contracts.csproj" />
    <ProjectReference Include="..\NxOpen.Foundation.Core\NxOpen.Foundation.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
  </PropertyGroup>

  <!--
    Per Skills/common.md non-negotiable #4: no hardcoded install paths, reference via UGII_BASE_DIR.
    Managed-assembly folder name/layout ("managed\NXOpen.dll", "managed\NXOpen.UF.dll") mirrors this
    repo's NxAdapters.csproj — NOT verified against a real install.
  -->
  <ItemGroup>
    <Reference Include="NXOpen">
      <HintPath>$(UGII_BASE_DIR)\managed\NXOpen.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="NXOpen.UF">
      <HintPath>$(UGII_BASE_DIR)\managed\NXOpen.UF.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

</Project>
