<Project Sdk="Microsoft.NET.Sdk">

  <!-- The material engine, free of NXOpen (every NX call goes through IPartMaterialService) so its tests run without an NX session. -->

  <ItemGroup>
    <ProjectReference Include="..\BANxOpen.Foundation.Contracts\BANxOpen.Foundation.Contracts.csproj" />
    <ProjectReference Include="..\BANxOpen.Foundation.Core\BANxOpen.Foundation.Core.csproj" />
  </ItemGroup>

  <!-- Uses NX's own Newtonsoft.Json so a tool inside NX never loads a second copy; building therefore needs NX installed. -->
  <Target Name="RequireUgiiBaseDir" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(UGII_BASE_DIR)' == ''"
           Text="UGII_BASE_DIR is not set. This project references Newtonsoft.Json from the NX installation (NXBIN\managed) and can only be built on a machine with NX installed." />
  </Target>

  <ItemGroup>
    <!-- Copy-local so the net8.0 tests find it beside the test binaries. -->
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(UGII_BASE_DIR)\NXBIN\managed\Newtonsoft.Json.dll</HintPath>
      <Private>True</Private>
    </Reference>
  </ItemGroup>

  <PropertyGroup>
    <TargetFrameworks>net48;net8.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
  </PropertyGroup>

</Project>